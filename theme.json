{
  "$schema": "./schema/theme.schema.json",
  "schemaVersion": 1,
  "name": "bruvbox",
  "palette": "tokens/palette.tokens.json",
  "variants": {
    "dark": "tokens/dark.tokens.json",
    "light": "tokens/light.tokens.json"
  },
  "combinations": {
    "canvas": {
      "foreground": "{text.primary}",
      "background": "{surface.canvas}",
      "minContrast": 4.5
    },
    "panel": {
      "foreground": "{text.primary}",
      "background": "{surface.raised}",
      "border": "{border.default}"
    },
    "muted": {
      "foreground": "{text.muted}",
      "background": "{surface.canvas}"
    },
    "selection": {
      "foreground": "{text.strong}",
      "background": "{surface.selection}"
    },
    "search": {
      "foreground": "{surface.canvas}",
      "background": "{accent.yellow}",
      "bold": true
    },
    "button": {
      "foreground": "{surface.canvas}",
      "background": "{accent.orange}",
      "bold": true
    },
    "button-hover": {
      "foreground": "{surface.canvas}",
      "background": "{text.strong}",
      "bold": true
    },
    "red-subtle": {
      "foreground": "{accent.red}",
      "background": "{tint.red}",
      "border": "{accent.red}"
    },
    "red-solid": {
      "foreground": "{surface.canvas}",
      "background": "{accent.red}",
      "bold": true
    },
    "green-subtle": {
      "foreground": "{accent.green}",
      "background": "{tint.green}",
      "border": "{accent.green}"
    },
    "green-solid": {
      "foreground": "{surface.canvas}",
      "background": "{accent.green}",
      "bold": true
    },
    "yellow-subtle": {
      "foreground": "{accent.yellow}",
      "background": "{tint.yellow}",
      "border": "{accent.yellow}"
    },
    "yellow-solid": {
      "foreground": "{surface.canvas}",
      "background": "{accent.yellow}",
      "bold": true
    },
    "blue-subtle": {
      "foreground": "{accent.blue}",
      "background": "{tint.blue}",
      "border": "{accent.blue}"
    },
    "blue-solid": {
      "foreground": "{surface.canvas}",
      "background": "{accent.blue}",
      "bold": true
    },
    "purple-subtle": {
      "foreground": "{accent.purple}",
      "background": "{tint.purple}",
      "border": "{accent.purple}"
    },
    "purple-solid": {
      "foreground": "{surface.canvas}",
      "background": "{accent.purple}",
      "bold": true
    },
    "aqua-subtle": {
      "foreground": "{accent.aqua}",
      "background": "{tint.aqua}",
      "border": "{accent.aqua}"
    },
    "aqua-solid": {
      "foreground": "{surface.canvas}",
      "background": "{accent.aqua}",
      "bold": true
    },
    "orange-subtle": {
      "foreground": "{accent.orange}",
      "background": "{tint.orange}",
      "border": "{accent.orange}"
    },
    "orange-solid": {
      "foreground": "{surface.canvas}",
      "background": "{accent.orange}",
      "bold": true
    },
    "error": {
      "extends": "red-subtle"
    },
    "warning": {
      "extends": "yellow-subtle"
    },
    "success": {
      "extends": "green-subtle"
    },
    "info": {
      "extends": "blue-subtle"
    },
    "diff-add": {
      "extends": "green-subtle"
    },
    "diff-delete": {
      "extends": "red-subtle"
    },
    "diff-change": {
      "extends": "blue-subtle"
    }
  }
}
