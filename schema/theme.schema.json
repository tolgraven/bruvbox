{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Portable theme composition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "palette",
    "variants",
    "combinations"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "palette": {
      "type": "string",
      "pattern": "\\.tokens\\.json$"
    },
    "variants": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "\\.tokens\\.json$"
      }
    },
    "combinations": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "foreground": {
            "type": "string",
            "pattern": "^\\{[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*\\}$"
          },
          "background": {
            "type": "string",
            "pattern": "^\\{[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*\\}$"
          },
          "border": {
            "type": "string",
            "pattern": "^\\{[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*\\}$"
          },
          "accent": {
            "type": "string",
            "pattern": "^\\{[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*\\}$"
          },
          "bold": {
            "type": "boolean"
          },
          "italic": {
            "type": "boolean"
          },
          "underline": {
            "type": "boolean"
          },
          "extends": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "minContrast": {
            "type": "number",
            "minimum": 1,
            "maximum": 21
          }
        },
        "anyOf": [
          {
            "required": [
              "extends"
            ]
          },
          {
            "required": [
              "foreground",
              "background"
            ]
          }
        ]
      }
    }
  }
}
