{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bruvbox supported DTCG color-token subset (2025.10)",
  "description": "Validates the supported authoring subset, not the complete DTCG standard. Runtime validates aliases, cycles, types and hex/component consistency.",
  "$ref": "#/definitions/group",
  "definitions": {
    "token": {
      "type": "object",
      "required": [
        "$value"
      ],
      "additionalProperties": false,
      "properties": {
        "$type": {
          "const": "color"
        },
        "$description": {
          "type": "string"
        },
        "$extensions": {
          "type": "object"
        },
        "$value": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\{[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*\\}$"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "colorSpace",
                "components"
              ],
              "properties": {
                "colorSpace": {
                  "const": "srgb"
                },
                "components": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "alpha": {
                  "const": 1
                },
                "hex": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              }
            }
          ]
        }
      }
    },
    "group": {
      "type": "object",
      "properties": {
        "$type": {
          "const": "color"
        },
        "$description": {
          "type": "string"
        },
        "$extensions": {
          "type": "object"
        }
      },
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "oneOf": [
            {
              "$ref": "#/definitions/token"
            },
            {
              "$ref": "#/definitions/group"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
